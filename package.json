{
  "name": "giser-maptalks-drawtool",
  "version": "1.0.3",
  "description": "maptalks DrawTool extension with self-intersection detection for polygon drawing",
  "main": "dist/giser-maptalks-drawtool.cjs.js",
  "module": "dist/giser-maptalks-drawtool.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/giser-maptalks-drawtool.esm.js",
      "require": "./dist/giser-maptalks-drawtool.cjs.js",
      "default": "./dist/giser-maptalks-drawtool.esm.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "node test/intersection.test.js"
  },
  "keywords": [
    "maptalks",
    "drawtool",
    "self-intersection",
    "polygon"
  ],
  "peerDependencies": {
    "maptalks": ">=1.0.0",
    "maptalks-gl": ">=0.124.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^8.5.0",
    "maptalks": "^1.0.0",
    "maptalks-gl": "^0.124.4",
    "rollup": "^2.80.0",
    "tslib": "^2.8.1",
    "typescript": "^4.9.5"
  }
}
